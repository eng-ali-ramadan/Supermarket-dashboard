@model List<SupermarketDashboard.Models.Sale>

<h2>قائمة البيعات</h2>

<a asp-action="Create" class="btn btn-primary mb-3">بيعة جديدة</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>المنتج</th>
            <th>الكمية</th>
            <th>سعر البيع</th>
            <th>الإجمالي</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SoldAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@s.Product?.Name</td>
                <td>@s.Quantity</td>
                <td>@s.UnitPrice.ToString("0.00")</td>
                <td>@s.Total.ToString("0.00")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning">تعديل</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline"
                          onsubmit="return confirm('متأكد إنك عايز تمسح البيعة دي؟');">
                        <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>