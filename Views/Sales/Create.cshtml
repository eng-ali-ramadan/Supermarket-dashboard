@model SupermarketDashboard.Models.Sale
@using System.Globalization
@using SupermarketDashboard.Models
@{
    var products = (List<Product>)ViewBag.Products;
    var sales = (List<Sale>)ViewBag.Sales;
    var expenses = (List<Expense>)ViewBag.Expenses;

    var totalRevenue = sales.Sum(s => s.Total);
    var totalExpenses = expenses.Sum(e => e.Amount);
    var netProfit = totalRevenue - totalExpenses;
    var todayRevenue = sales.Where(s => s.SoldAt.Date == DateTime.Today).Sum(s => s.Total);
    var todayCount = sales.Count(s => s.SoldAt.Date == DateTime.Today);
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<!-- ============ الإحصائيات ============ -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">إجمالي الإيرادات</h6>
                <h4 class="text-success">@totalRevenue.ToString("0.00") جنيه</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">إجمالي المصروفات</h6>
                <h4 class="text-danger">@totalExpenses.ToString("0.00") جنيه</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">صافي الربح</h6>
                <h4 class="@(netProfit >= 0 ? "text-primary" : "text-danger")">@netProfit.ToString("0.00") جنيه</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">إيرادات النهارده (@todayCount بيعة)</h6>
                <h4>@todayRevenue.ToString("0.00") جنيه</h4>
            </div>
        </div>
    </div>
</div>

<!-- ============ فورم البيعة الجديدة ============ -->
<div class="card shadow-sm mb-4">
    <div class="card-header"><strong>بيعة جديدة</strong></div>
    <div class="card-body">
        <form asp-action="Create" method="post" style="max-width:420px">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">المنتج</label>
                <select asp-for="ProductId" class="form-select" id="productSelect">
                    <option value="">-- اختار منتج --</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id" data-price="@p.Price.ToString(CultureInfo.InvariantCulture)">
                            @p.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnitPrice" class="form-label">سعر البيع</label>
                <input asp-for="UnitPrice" class="form-control" id="priceInput" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">الكمية</label>
                <input asp-for="Quantity" class="form-control" id="qtyInput" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <p><strong>الإجمالي: <span id="totalText">0.00</span> جنيه</strong></p>

            <button type="submit" class="btn btn-success">تأكيد البيعة</button>
        </form>
    </div>
</div>

